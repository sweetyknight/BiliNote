FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# 使用国内镜像源加速 apt
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    apt update && \
    apt install -y --no-install-recommends ffmpeg python3-pip python3-dev && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# 设置环境变量
ENV HF_ENDPOINT=https://hf-mirror.com
ENV PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

# 先复制依赖文件（利用Docker层缓存）
COPY ./backend/requirements.txt /app/requirements.txt

# 使用国内 PyTorch 镜像源安装（比官方源快很多）
# 清华源有 CUDA 12.4 版本的 PyTorch
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.extra-index-url "https://download.pytorch.org/whl/cu124" && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

# 安装其他依赖（跳过 torch 相关）
RUN grep -v "^torch" requirements.txt | grep -v "^--extra-index-url" > requirements_filtered.txt && \
    pip install --no-cache-dir -r requirements_filtered.txt

# 再复制源代码（代码变更不会触发重新安装依赖）
COPY ./backend /app

CMD ["python3", "main.py"]
